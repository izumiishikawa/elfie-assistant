#!/usr/bin/env python3

import json
import socket
import sys

SOCK_PATH = '/tmp/elfie.sock'


def send(cmd: dict) -> dict:
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCK_PATH)
        s.sendall((json.dumps(cmd) + '\n').encode())
        data = b''
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
            if b'\n' in data:
                break
        s.close()
        return json.loads(data.decode().strip())
    except FileNotFoundError:
        print('elfie-daemon não está rodando.', file=sys.stderr)
        sys.exit(1)
    except ConnectionRefusedError:
        print('elfie-daemon não está rodando.', file=sys.stderr)
        sys.exit(1)


def main():
    args = sys.argv[1:]

    if not args or args[0] in ('-h', '--help', 'help'):
        print('uso:')
        print('  elfie status                  — estado atual')
        print('  elfie switch <chatId>         — troca o chat ativo')
        print('  elfie mute                    — muta o microfone')
        print('  elfie unmute                  — desmuta o microfone')
        print('  elfie provider <whisper|elevenlabs>  — troca o STT')
        print('  elfie stop                    — encerra o daemon')
        return

    cmd = args[0]

    if cmd == 'status':
        r = send({'cmd': 'status'})
        if 'error' in r:
            print(f'erro: {r["error"]}')
            return
        mute = ' [MUDO]' if r.get('muted') else ''
        print(f'estado:   {r.get("state")}{mute}')
        print(f'chatId:   {r.get("chatId") or "(não configurado)"}')
        print(f'provider: {r.get("sttProvider")}')
        print(f'api:      {r.get("apiBase")}')

    elif cmd == 'switch':
        if len(args) < 2:
            print('uso: elfie switch <chatId>', file=sys.stderr)
            sys.exit(1)
        r = send({'cmd': 'switch', 'chatId': args[1]})
        if 'error' in r:
            print(f'erro: {r["error"]}', file=sys.stderr)
        else:
            print(f'chat trocado para: {r["chatId"]}')

    elif cmd == 'mute':
        r = send({'cmd': 'mute'})
        if 'error' in r:
            print(f'erro: {r["error"]}', file=sys.stderr)
        else:
            print('microfone mutado.')

    elif cmd == 'unmute':
        r = send({'cmd': 'unmute'})
        if 'error' in r:
            print(f'erro: {r["error"]}', file=sys.stderr)
        else:
            print('microfone ativo.')

    elif cmd == 'provider':
        if len(args) < 2:
            print('uso: elfie provider <whisper|elevenlabs>', file=sys.stderr)
            sys.exit(1)
        r = send({'cmd': 'provider', 'provider': args[1]})
        if 'error' in r:
            print(f'erro: {r["error"]}', file=sys.stderr)
        else:
            print(f'provider trocado para: {r["sttProvider"]}')

    elif cmd == 'stop':
        r = send({'cmd': 'stop'})
        if 'error' in r:
            print(f'erro: {r["error"]}', file=sys.stderr)
        else:
            print('daemon encerrado.')

    else:
        print(f'comando desconhecido: {cmd}', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
