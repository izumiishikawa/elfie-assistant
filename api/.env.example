OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL=anthropic/claude-opus-4-5
# Or use DeepSeek directly:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
APP_URL=http://localhost:3000
PORT=3000
WS_PORT=41906
TAVILY_API_KEY=tvly-...
# Voice — TTS and STT providers are switched independently in Settings > Voz (defaults
# to ElevenLabs for both). The Fish Audio key can also be entered there instead of here.
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# FISHAUDIO_API_KEY=fa-...
# FISHAUDIO_VOICE_ID=your_model_id
# Inworld Speech-to-Speech (experimental "fast lane" call mode, toggled per-character
# in that character's editor — does not replace the default STT/LLM/TTS pipeline above).
# Works in elfie-web's call screen and in the desktop daemon.
# INWORLD_API_KEY=base64(key:secret) from https://platform.inworld.ai
# Tool calling (list_voices/change_voice) inside the Inworld session requires a paid
# plan with billing configured on your Inworld account — without that it errors out
# ("Tool calling is currently restricted on your plan") and kills every response, no
# audio at all. Left off by default for that reason; flip on only after adding billing.
# INWORLD_TOOLS_ENABLED=true
# TTS model used for the call's audio output. Defaults to inworld-tts-2-flash, the
# low-latency variant — best for a live call. Set it to inworld-tts-2 to trade some
# latency for expressiveness: that's the only model that honors the inline [steering]
# tags the LLM emits for emotion/emphasis ([whisper], [speak softly, like a secret],
# [sigh]...). On -flash those tags are ignored, so the prompt that teaches her to use
# them is switched off automatically along with the model — no need to change anything
# else here. See https://docs.inworld.ai/tts/capabilities/steering
# INWORLD_TTS_MODEL=inworld-tts-2
# How eagerly Inworld's semantic VAD decides your turn is over. Defaults to "low", which
# waits for clearer pauses — with "medium" (Inworld's own default) room noise was enough
# to close a turn, producing phantom transcriptions ("Ah", "嗯") the user never said.
# Raise it to "medium"/"high" if she now feels slow to reply; "auto" lets Inworld pick.
# Accepted: auto | low | medium | high
# INWORLD_VAD_EAGERNESS=medium
# The same INWORLD_API_KEY above also authenticates Inworld's LLM Router (a separate,
# OpenAI-compatible /v1/chat/completions endpoint that proxies 220+ models) if you pick
# "Inworld" as the AI Provider in Settings > Provider — an alternative to OpenRouter/
# DeepSeek for text chat, on the same billing as the voice call feature above. No extra
# key needed; just set INWORLD_API_KEY and switch the provider in the app.
# PixAI (anime/manga image generation, the generate_anime_image tool). Unofficial — there
# is no public API, so it uses the same session token the website keeps in the browser:
# DevTools > Application > Local Storage > api.pixai.art:token. It EXPIRES (about a week),
# so the app reads it from Settings > AI Provider > Image generation first and only falls
# back to this file — set it there instead of here so you can refresh it without a restart.
# PIXAI_TOKEN=eyJhbGciOi...
# Model to generate with (a pixai.art model id). Defaults to 1648918127446573124.
# PIXAI_MODEL_ID=1648918127446573124
# Nano Banana / Nano Banana Pro (image generation + editing) go through OpenRouter's
# Images API — reuses OPENROUTER_API_KEY above, billed as OpenRouter credits (no
# separate Google Cloud billing needed). No extra key required.
# Google integrations (Gmail/Calendar/Drive OAuth) — Client ID/Secret are set from the
# app itself now (Settings > Integrações), not here. The redirect URI Google needs
# (shown in that same screen) is derived from APP_URL above — override it here only if
# you need something other than http://localhost:3000/api/integrations/google/callback.
# Google rejects raw LAN IPs as redirect URIs (only localhost/loopback or HTTPS domains
# are allowed), so this has to stay on localhost — connecting a Google account only
# works from a browser on this same machine, not over the LAN.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Agentic browser (browser_navigate/click/type/... tools) — a real, persistent Chromium
# profile (cookies/logins survive restarts) that Elfie drives directly, separate from the
# throwaway one-off tab used by browse_screenshot. Headed (a visible window) by default,
# since that's far less likely to get flagged as a bot than headless — needs a display on
# whatever machine runs the API. Set to true only if running on a headless box.
# BROWSER_HEADLESS=false
# Real mouse/keyboard control (computer_screenshot/click/type/key/... tools) — the fallback
# for whatever browser_* can't reach (native apps, canvas-only controls, anti-automation
# checks). No env var needed, but it shells out to two system tools that must be on PATH:
# `xdotool` (mouse/keyboard, works through XWayland even on a Wayland compositor) and
# `grim` (screenshots — Wayland-native, wlroots compositors only e.g. Hyprland/Sway; on
# X11 or a non-wlroots compositor swap it for something else, e.g. `scrot`/`maim`, in
# computerScreenshot() in src/computerControl.js). On Arch: `pacman -S xdotool grim`.
