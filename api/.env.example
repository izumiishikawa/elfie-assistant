OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL=anthropic/claude-opus-4-5
# Or use DeepSeek directly:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
APP_URL=http://localhost:3000
PORT=3000
WS_PORT=41906
TAVILY_API_KEY=tvly-...
PIXELLAB_API_KEY=px-...
# Voice — TTS and STT providers are switched independently in Settings > Voz (defaults
# to ElevenLabs for both). The Fish Audio key can also be entered there instead of here.
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# FISHAUDIO_API_KEY=fa-...
# FISHAUDIO_VOICE_ID=your_model_id
# Nano Banana / Nano Banana Pro (image generation + editing) go through OpenRouter's
# Images API — reuses OPENROUTER_API_KEY above, billed as OpenRouter credits (no
# separate Google Cloud billing needed). No extra key required.
# Google integrations (Gmail/Calendar/Drive OAuth) — Client ID/Secret are set from the
# app itself now (Settings > Integrações), not here. The redirect URI Google needs
# (shown in that same screen) is derived from APP_URL above — override it here only if
# you need something other than http://localhost:3000/api/integrations/google/callback.
# Google rejects raw LAN IPs as redirect URIs (only localhost/loopback or HTTPS domains
# are allowed), so this has to stay on localhost — connecting a Google account only
# works from a browser on this same machine, not over the LAN.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Agentic browser (browser_navigate/click/type/... tools) — a real, persistent Chromium
# profile (cookies/logins survive restarts) that Elfie drives directly, separate from the
# throwaway one-off tab used by browse_screenshot. Headed (a visible window) by default,
# since that's far less likely to get flagged as a bot than headless — needs a display on
# whatever machine runs the API. Set to true only if running on a headless box.
# BROWSER_HEADLESS=false
# Real mouse/keyboard control (computer_screenshot/click/type/key/... tools) — the fallback
# for whatever browser_* can't reach (native apps, canvas-only controls, anti-automation
# checks). No env var needed, but it shells out to two system tools that must be on PATH:
# `xdotool` (mouse/keyboard, works through XWayland even on a Wayland compositor) and
# `grim` (screenshots — Wayland-native, wlroots compositors only e.g. Hyprland/Sway; on
# X11 or a non-wlroots compositor swap it for something else, e.g. `scrot`/`maim`, in
# computerScreenshot() in src/computerControl.js). On Arch: `pacman -S xdotool grim`.
