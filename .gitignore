# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
/.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase config — tied to a shared project with an unrelated app, don't publish it
/google-services.json

# uploaded and generated files (voices, images, pixel art)
api/uploads/*
!api/uploads/.gitkeep

# Log diagnóstico do daemon Inworld (INWORLD_DEBUG=1) — contém transcrições de voz
daemon/inworld_debug.log

# Overlay/daemon: caches do Python
__pycache__/
*.pyc

# Log da sessao Inworld nova (INWORLD_CALL_DEBUG=1) — contem transcricoes de voz
daemon/inworld_call_debug.log
